---
import type { Link } from '../data/portfolio';
interface Props { links: Link[] }
const { links } = Astro.props;
---
{links.some(link => link.href) && <ul class="resource-links" role="list">
  {links.filter(link => link.href).map(link => (
    <li><a href={link.href}>{link.label}<span aria-hidden="true"> ↗</span></a></li>
  ))}
</ul>}
